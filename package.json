{
  "name": "data-cleaning-quest",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --filter @dcq/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "validate-content": "tsx scripts/validate-content.mjs",
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "postinstall": "node scripts/fetch-pyodide.mjs",
    "prepare": "husky",
    "e2e": "pnpm --filter @dcq/web e2e"
  },
  "devDependencies": {
    "@dcq/content-schema": "workspace:*",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  }
}
