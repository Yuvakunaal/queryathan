{
  "name": "queryathan",
  "private": true,
  "version": "1.0.0",
  "description": "Learn real pandas and SQL by playing: a no-login, in-browser game of data cleaning and analysis.",
  "homepage": "https://github.com/Yuvakunaal/queryathan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuvakunaal/queryathan.git"
  },
  "bugs": {
    "url": "https://github.com/Yuvakunaal/queryathan/issues"
  },
  "keywords": [
    "pandas",
    "sql",
    "sqlite",
    "pyodide",
    "data-cleaning",
    "education",
    "game",
    "webassembly",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --filter @dcq/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "validate-content": "tsx scripts/validate-content.mjs",
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "postinstall": "node scripts/fetch-pyodide.mjs",
    "prepare": "husky",
    "e2e": "pnpm --filter @dcq/web e2e"
  },
  "devDependencies": {
    "@dcq/content-schema": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  }
}
