{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4173",
      "startServerReadyPattern": "serving apps/web/dist",
      "url": ["http://localhost:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 370000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1000000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
