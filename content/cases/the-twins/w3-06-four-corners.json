  "hints": {
    "python": [
      "Chain three merges, each on the key the two sides share. Use how='left' every time so no order is lost.",
      "Merge on customer_id, then product_id, then store_id. The orders that point to a missing customer or store stay, with empty names.",
      "df = df.merge(customers, on='customer_id', how='left').merge(products, on='product_id', how='left').merge(stores, on='store_id', how='left'); line_total = qty * unit_price * (1 - discount_pct / 100)."
    ],
    "sql": [
      "Three LEFT JOINs in a row: customers, products, stores. LEFT JOIN keeps an order even when its customer or store is not listed.",
      "The discount comes off the price: d.qty * p.unit_price * (1 - d.discount_pct / 100.0). Use 100.0, not 100, so the division is not whole numbers only.",
      "CREATE TABLE result AS SELECT d.order_id, c.customer_name, p.product_name, s.store_name, s.region, d.qty * p.unit_price * (1 - d.discount_pct / 100.0) AS line_total FROM data d LEFT JOIN customers c ON c.customer_id = d.customer_id LEFT JOIN products p ON p.product_id = d.product_id LEFT JOIN stores s ON s.store_id = d.store_id;"
    ]
  },
