# dependencies
node_modules/

# build output
dist/
dist-worker/
build/
*.tsbuildinfo

# Pyodide runtime — fetched via scripts/fetch-pyodide.mjs, never committed
apps/web/public/pyodide/

# test / e2e artifacts
coverage/
playwright-report/
test-results/

# graphify — GRAPH_REPORT.md is committed, everything else is local state
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# local Claude Code session state
.claude/

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# env
.env
.env.local

# deploy
.vercel/
